{
  "id": "builtin.codespaces",
  "name": "GitHub Codespaces",
  "description": "Set up and connect to GitHub Codespaces from LVCE Editor",
  "repository": "https://github.com/lvce-editor/codespaces",
  "browser": "dist/codespacesMain.js",
  "isolated": true,
  "preserveRuntimeOnWorkspaceChange": true,
  "compatibility": {
    "web": true
  },
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self'",
    "connect-src https: wss: http://127.0.0.1:* ws://127.0.0.1:*"
  ],
  "activation": [
    "onCommand:codespaces.setup",
    "onCommand:codespaces.connect",
    "onCommand:codespaces.getWebSocketUrl",
    "onCommand:codespaces.disconnect",
    "onFileSystem:codespaces",
    "onPorts:codespaces",
    "onCommand:codespaces.refreshPorts",
    "onCommand:codespaces.start",
    "onCommand:codespaces.stop",
    "onCommand:codespaces.stopAll",
    "onCommand:codespaces.authorize",
    "onCommand:codespaces.connectGateway",
    "onCommand:codespaces.openInBrowser",
    "onCommand:codespaces.viewCreationLog",
    "onView:builtin.codespaces-preview"
  ],
  "commands": [
    { "id": "codespaces.refreshPorts", "label": "Codespaces: Refresh Ports" },
    {
      "id": "codespaces.setup",
      "label": "Codespaces: Set Up a Codespace"
    },
    {
      "id": "codespaces.connect",
      "label": "Codespaces: Connect to Codespace"
    },
    {
      "id": "codespaces.disconnect",
      "label": "Codespaces: Disconnect"
    },
    {
      "id": "codespaces.getWebSocketUrl",
      "internal": true
    },
    {
      "id": "codespaces.start",
      "label": "Codespaces: Start Codespace"
    },
    {
      "id": "codespaces.stop",
      "label": "Codespaces: Stop Codespace"
    },
    {
      "id": "codespaces.stopAll",
      "label": "Codespaces: Stop All Codespaces"
    },
    {
      "id": "codespaces.authorize",
      "label": "Codespaces: Authorize GitHub Access"
    },
    {
      "id": "codespaces.connectGateway",
      "label": "Codespaces: Connect to Manual Gateway"
    },
    {
      "id": "codespaces.openInBrowser",
      "label": "Codespaces: Open in Browser"
    },
    {
      "id": "codespaces.viewCreationLog",
      "label": "Codespaces: View Creation Log"
    }
  ],
  "fileSystemProviders": [
    {
      "id": "codespaces"
    }
  ],
  "outputChannels": [
    {
      "id": "codespaces",
      "label": "Codespaces"
    }
  ],
  "views": [
    {
      "id": "builtin.codespaces-preview",
      "title": "Application Preview",
      "kind": "virtualDom",
      "type": "preview",
      "showSideBarHeader": false
    }
  ]
}
